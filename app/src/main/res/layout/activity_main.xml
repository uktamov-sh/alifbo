<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_intro"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/surface"
            android:padding="14dp"
            android:textColor="@color/new_letter"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Step"
            android:text="@string/step_enable" />

        <Button
            android:id="@+id/enable"
            style="@style/ActionButton"
            android:text="@string/btn_enable" />

        <TextView
            style="@style/Step"
            android:text="@string/step_choose" />

        <Button
            android:id="@+id/choose"
            style="@style/ActionButton"
            android:text="@string/btn_choose" />

        <TextView
            style="@style/Step"
            android:text="@string/try_title" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/try_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/android_warning"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            style="@style/Step"
            android:text="@string/settings_title" />

        <Switch
            android:id="@+id/setting_vibration"
            style="@style/SettingSwitch"
            android:text="@string/setting_vibration" />

        <Switch
            android:id="@+id/setting_sound"
            style="@style/SettingSwitch"
            android:text="@string/setting_sound" />

        <Switch
            android:id="@+id/setting_preview"
            style="@style/SettingSwitch"
            android:text="@string/setting_preview" />

        <Switch
            android:id="@+id/setting_suggestions"
            style="@style/SettingSwitch"
            android:text="@string/setting_suggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setting_height"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/setting_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/height_small"
                style="@style/HeightOption"
                android:text="@string/height_small" />

            <RadioButton
                android:id="@+id/height_medium"
                style="@style/HeightOption"
                android:text="@string/height_medium" />

            <RadioButton
                android:id="@+id/height_large"
                style="@style/HeightOption"
                android:text="@string/height_large" />
        </RadioGroup>

        <TextView
            style="@style/Step"
            android:text="@string/privacy_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/privacy_body"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictionary_credits"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
